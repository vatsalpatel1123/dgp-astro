  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Animation Observer
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }
        });
      }, observerOptions);

      document.querySelectorAll('.capability-card').forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px)';
        card.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
        observer.observe(card);
      });

      document.querySelectorAll('.benefit-card').forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px)';
        card.style.transition = `opacity 0.6s ease ${index * 0.15}s, transform 0.6s ease ${index * 0.15}s`;
        observer.observe(card);
      });

      // Maria Call Form Handler
      const form = document.getElementById('maria-call-form');
      const phoneInput = document.getElementById('phone-number');
      const countryCodeSelect = document.getElementById('country-code');
      const errorMessage = document.getElementById('error-message');
      const successMessage = document.getElementById('success-message');
      const submitBtn = document.getElementById('submit-btn');
      const spinner = submitBtn.querySelector('.spinner');
      const buttonText = submitBtn.querySelector('span');

      // Phone number validation function
      function validatePhoneNumber(phone) {
        // Remove all non-digit characters
        const cleaned = phone.replace(/\D/g, '');

        // Check if phone number has at least 10 digits
        if (cleaned.length < 10) {
          return {
            valid: false,
            message: 'Phone number must have at least 10 digits'
          };
        }

        // Check if phone number has maximum 15 digits (international standard)
        if (cleaned.length > 15) {
          return {
            valid: false,
            message: 'Phone number is too long (max 15 digits)'
          };
        }

        return { valid: true, cleaned };
      }

      // Hide messages function
      function hideMessages() {
        errorMessage.classList.remove('show');
        successMessage.classList.remove('show');
      }

      // Show error message
      function showError(message) {
        hideMessages();
        errorMessage.textContent = message;
        errorMessage.classList.add('show');
      }

      // Show success message
      function showSuccess(message) {
        hideMessages();
        successMessage.textContent = message;
        successMessage.classList.add('show');
      }

      // Set loading state
      function setLoading(loading) {
        if (loading) {
          submitBtn.classList.add('loading');
          spinner.style.display = 'inline-block';
          buttonText.textContent = 'Calling...';
        } else {
          submitBtn.classList.remove('loading');
          spinner.style.display = 'none';
          buttonText.textContent = 'Call Me Now';
        }
      }

      // Form submit handler
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        hideMessages();

        const phoneNumber = phoneInput.value.trim();
        const countryCode = countryCodeSelect.value;

        // Validate phone number
        const validation = validatePhoneNumber(phoneNumber);
        if (!validation.valid) {
          showError(validation.message);
          phoneInput.focus();
          return;
        }

        // Construct full phone number
        const fullPhoneNumber = `${countryCode}${validation.cleaned}`;

        // Set loading state
        setLoading(true);

        try {
          // Send POST request to n8n webhook
          const response = await fetch('https://n8n.srv791889.hstgr.cloud/webhook/maria-call-agent', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              phoneNumber: fullPhoneNumber,
              countryCode: countryCode,
              rawNumber: validation.cleaned,
              timestamp: new Date().toISOString(),
              source: 'ai-voice-receptionist-page'
            })
          });

          if (response.ok) {
            showSuccess('Success! Maria will call you shortly. Redirecting...');
            form.reset();

            // Redirect to VSL page after 2 seconds
            setTimeout(() => {
              window.location.href = '/vsl-page';
            }, 2000);
          } else {
            const errorData = await response.json().catch(() => ({}));
            showError(errorData.message || 'Something went wrong. Please try again or call us directly at +1 +1 561 461 0636.');
          }
        } catch (error) {
          console.error('Form submission error:', error);
          showError('Network error. Please check your connection and try again.');
        } finally {
          setLoading(false);
        }
      });

      // Real-time phone number formatting (optional)
      phoneInput.addEventListener('input', function(e) {
        // Remove any non-digit characters except + and spaces
        let value = e.target.value.replace(/[^\d\s\-()]/g, '');
        e.target.value = value;
      });

      // Clear error on input
      phoneInput.addEventListener('focus', hideMessages);
      countryCodeSelect.addEventListener('change', hideMessages);
    });
  </script>

</body>
