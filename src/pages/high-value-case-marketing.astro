---
// high-value-case-marketing.astro - Updated with blue theme
import '../css/main.css';
import Navigation from '../components/Navigation.astro';
import FooterBar from '../components/FooterBar.astro';
import StickyCTA from '../components/StickyCTA.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Premier Case AI | Dentistry Growth Partners</title>
  <meta name="description" content="Premium marketing strategies focused on attracting patients seeking veneers, crowns, bridges, and other high-value dental treatments.">
  <link rel="icon" type="image/png" href="/636f4050ef41c9124a12cbba/dgp-logo1.png" />
  <link rel="shortcut icon" type="image/png" href="/636f4050ef41c9124a12cbba/dgp-logo1.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary-light: #EDEDE8;
      --primary-dark: #051023;
      --primary-blue: #07387D;
      --accent-blue: #248EEF;
      --white: #ffffff;
      --black: #1d1d1d;
      --grey: #f5f5f5;
      --dim-grey: #646464;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--white);
      color: var(--black);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .section-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Hero Section with Background */
    .hero-section {
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 140px 24px 80px;
    }

    .hero-background-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url('https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=1920&q=80');
      background-size: cover;
      background-position: center;
      z-index: 0;
    }

    .hero-background-overlay::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(5, 16, 35, 0.92) 0%, rgba(7, 56, 125, 0.88) 50%, rgba(36, 142, 239, 0.85) 100%);
      z-index: 1;
    }

    .hero-container {
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(36, 142, 239, 0.15);
      backdrop-filter: blur(10px);
      border: 2px solid rgba(36, 142, 239, 0.4);
      padding: 12px 28px;
      border-radius: 50px;
      color: var(--white);
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 32px;
    }

    .hero-badge i {
      font-size: 20px;
      color: var(--accent-blue);
    }

    .hero-section h1 {
      font-size: clamp(40px, 5.5vw, 68px);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
      margin: 0 auto 24px;
      letter-spacing: -1.8px;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      max-width: 1000px;
      padding: 0 20px;
    }

    .hero-section .highlight {
      color: var(--accent-blue);
      background: linear-gradient(135deg, #248EEF 0%, #5ba8ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-section .hero-subtitle {
      font-size: clamp(18px, 2.2vw, 22px);
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.6;
      margin-bottom: 48px;
      max-width: 900px;
    }

    .hero-section .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 42px;
      background: var(--accent-blue);
      color: var(--white);
      font-size: 17px;
      font-weight: 700;
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 3px solid var(--accent-blue);
      box-shadow: 0 8px 24px rgba(36, 142, 239, 0.3);
      margin-bottom: 28px;
    }

    .hero-section .hero-cta:hover {
      background: transparent;
      color: var(--accent-blue);
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(36, 142, 239, 0.4);
    }

    /* Section Styles */
    .section-header {
      max-width: 800px;
      margin: 0 auto 60px;
      text-align: center;
    }

    .section-tag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--primary-light);
      color: var(--primary-blue);
      padding: 10px 24px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .section-tag i {
      font-size: 18px;
    }

    .section-title {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 16px;
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .section-description {
      font-size: 18px;
      color: var(--dim-grey);
      line-height: 1.7;
      max-width: 700px;
      margin: 0 auto 48px;
    }

    /* Case Types Section */
    .case-types-section {
      padding: 120px 24px;
      background: var(--white);
    }

    .case-types-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .case-type-card {
      background: var(--white);
      border: 3px solid var(--grey);
      border-radius: 20px;
      padding: 40px 36px;
      transition: all 0.4s ease;
    }

    .case-type-card:hover {
      border-color: var(--accent-blue);
      transform: translateY(-8px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    }

    .case-type-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      color: var(--accent-blue);
      margin-bottom: 24px;
      transition: all 0.4s ease;
    }

    .case-type-card:hover .case-type-icon {
      transform: scale(1.1) rotate(5deg);
    }

    .case-type-card h3 {
      font-size: 24px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 8px;
    }

    .case-type-value {
      font-size: 16px;
      color: var(--accent-blue);
      font-weight: 700;
      margin-bottom: 12px;
    }

    .case-type-card p {
      font-size: 15px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
    }

    /* Approach Section */
    .approach-section {
      padding: 120px 24px;
      background: var(--grey);
    }

    .approach-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .approach-card {
      background: var(--white);
      border: 3px solid transparent;
      border-radius: 24px;
      padding: 48px 40px;
      transition: all 0.4s ease;
    }

    .approach-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
      border-color: var(--accent-blue);
    }

    .approach-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      color: var(--accent-blue);
      padding: 10px 20px;
      border-radius: 50px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 24px;
    }

    .approach-card h3 {
      font-size: 26px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 16px;
    }

    .approach-card p {
      font-size: 16px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
    }

    /* Results Section */
    .results-section {
      padding: 120px 24px;
      background: var(--white);
    }

    .results-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      max-width: 1200px;
      margin: 60px auto 0;
    }

    .result-card {
      background: linear-gradient(135deg, var(--primary-blue), var(--primary-dark));
      border-radius: 24px;
      padding: 48px 36px;
      text-align: center;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .result-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .result-icon {
      width: 80px;
      height: 80px;
      background: rgba(36, 142, 239, 0.15);
      border: 3px solid var(--accent-blue);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      font-size: 36px;
      color: var(--accent-blue);
    }

    .result-card h3 {
      font-size: 42px;
      font-weight: 800;
      color: var(--accent-blue);
      margin-bottom: 12px;
      letter-spacing: -1px;
    }

    .result-label {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.95);
      font-weight: 600;
      line-height: 1.4;
    }

    /* Final CTA Section */
    .final-cta-section {
      padding: 100px 24px;
      background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-dark) 100%);
      position: relative;
      overflow: hidden;
    }

    .final-cta-content {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 10;
    }

    .final-cta-icon {
      width: 100px;
      height: 100px;
      background: rgba(36, 142, 239, 0.15);
      border: 3px solid var(--accent-blue);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 32px;
      font-size: 48px;
      color: var(--accent-blue);
    }

    .final-cta-section h2 {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      color: var(--white);
      margin-bottom: 24px;
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .final-cta-text {
      font-size: 20px;
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.7;
      margin-bottom: 40px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .final-cta-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 20px 48px;
      background: var(--accent-blue);
      color: var(--white);
      font-size: 18px;
      font-weight: 700;
      border-radius: 14px;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 3px solid var(--accent-blue);
      box-shadow: 0 8px 24px rgba(36, 142, 239, 0.3);
    }

    .final-cta-button:hover {
      background: transparent;
      color: var(--accent-blue);
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(36, 142, 239, 0.4);
    }

    /* Responsive */
    @media (max-width: 991px) {
      .hero-section {
        padding: 130px 24px 80px;
        min-height: 85vh;
      }

      .case-types-grid,
      .approach-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      .results-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }
    }

    @media (max-width: 767px) {
      .hero-section {
        padding: 120px 20px 60px;
        min-height: 80vh;
      }

      .hero-section h1 {
        font-size: clamp(32px, 7vw, 44px);
      }

      .results-grid {
        grid-template-columns: 1fr;
      }

      .case-types-section,
      .approach-section,
      .results-section,
      .final-cta-section {
        padding: 80px 24px;
      }
    }

    @media (max-width: 479px) {
      .hero-section {
        padding: 110px 16px 50px;
      }

      .hero-section h1 {
        font-size: clamp(28px, 8vw, 38px);
      }
    }
  </style>
</head>
<body>
  <Navigation />
  
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-background-overlay"></div>

    <div class="hero-container">
      <!-- <div class="hero-badge">
        <i class="ti ti-diamond"></i>
        <span>Premium Cases</span>
      </div> -->

      <h1>
        Premier Case AI
      </h1>

      <p class="hero-subtitle">
        Premium marketing strategies focused on attracting patients seeking veneers, crowns, 
        bridges, and other high-value dental treatments.
      </p>

      <!-- <a href="/book-a-call" class="hero-cta">
        <i class="ti ti-calendar-event"></i>
        Let's Talk
      </a> -->
    </div>
  </section>

  <!-- Case Types Section -->
  <section class="case-types-section">
    <div class="section-container">
      <div class="section-header">
        <span class="section-tag">
          <i class="ti ti-briefcase"></i>
          Target Cases
        </span>
        <h2 class="section-title">High-Value Treatments We Attract</h2>
        <p class="section-description">
          From full-mouth reconstructions to cosmetic smile makeovers, our marketing strategies 
          are designed to attract patients seeking complex, high-investment dental treatments.
        </p>
      </div>

      <div class="case-types-grid">
        
        <div class="case-type-card">
          <div class="case-type-icon">
            <i class="ti ti-dental"></i>
          </div>
          <h3>Full-Mouth Reconstructions</h3>
          <p class="case-type-value">$40K - $100K+</p>
          <p>
            Complete restoration of both upper and lower arches using implants, crowns, and 
            advanced prosthodontic techniques.
          </p>
        </div>

        <div class="case-type-card">
          <div class="case-type-icon">
            <i class="ti ti-building-arch"></i>
          </div>
          <h3>All-on-4 / All-on-6 Procedures</h3>
          <p class="case-type-value">$25K - $75K</p>
          <p>
            Full-arch restoration using strategically placed implants to support a fixed prosthesis—
            delivering a complete smile in one day.
          </p>
        </div>

        <div class="case-type-card">
          <div class="case-type-icon">
            <i class="ti ti-tool"></i>
          </div>
          <h3>Complex Implant Cases</h3>
          <p class="case-type-value">$20K - $50K</p>
          <p>
            Multi-unit implant treatments requiring bone grafting, sinus lifts, or advanced 
            surgical planning for optimal outcomes.
          </p>
        </div>

        <div class="case-type-card">
          <div class="case-type-icon">
            <i class="ti ti-sparkles"></i>
          </div>
          <h3>Smile Makeovers with Veneers</h3>
          <p class="case-type-value">$15K - $40K</p>
          <p>
            Comprehensive cosmetic transformations combining veneers, crowns, and implants to 
            create stunning, natural-looking results.
          </p>
        </div>

      </div>

      <p class="section-description" style="margin-top: 48px; font-style: italic;">
        Don't see a treatment you want more of? Don't worry—our marketing strategy works for 
        any practice looking for any type of high-value treatment.
      </p>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="approach-section">
    <div class="section-container">
      <div class="section-header">
        <span class="section-tag">
          <i class="ti ti-target-arrow"></i>
          Our Methodology
        </span>
        <h2 class="section-title">How We Attract Premium Patients</h2>
        <p class="section-description">
          <strong>It's the same proven system as our Multi-Implant Marketing—just tailored for 
          other high-value cases.</strong> Whether you want more veneers, crowns, or smile makeovers, 
          our six integrated systems work seamlessly to deliver qualified patients ready for treatment.
        </p>
      </div>

      <div class="approach-grid">
        
        <div class="approach-card">
          <div class="approach-badge">
            <i class="ti ti-target"></i>
            Step 1
          </div>
          <h3>Targeted Campaigns</h3>
          <p>
            Precision audience targeting based on income, demographics, and search behavior. We 
            reach patients actively seeking premium dental solutions and have the financial means 
            to invest in their smile.
          </p>
        </div>

        <div class="approach-card">
          <div class="approach-badge">
            <i class="ti ti-crown"></i>
            Step 2
          </div>
          <h3>Premium Positioning</h3>
          <p>
            Marketing that positions your practice as the authority for complex cases. We showcase 
            your expertise, technology, and results to attract patients who value quality over cost.
          </p>
        </div>

        <div class="approach-card">
          <div class="approach-badge">
            <i class="ti ti-book"></i>
            Step 3
          </div>
          <h3>Education-First Content</h3>
          <p>
            Content that educates and builds trust before the consultation. Patients arrive informed, 
            confident, and ready to move forward—not price shopping or hesitant.
          </p>
        </div>

        <div class="approach-card">
          <div class="approach-badge">
            <i class="ti ti-filter"></i>
            Step 4
          </div>
          <h3>Quality Screening</h3>
          <p>
            Multi-stage qualification to ensure financial capability and treatment readiness. We filter 
            out tire-kickers so you only meet with serious, qualified patients.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="results-section">
    <div class="section-container">
      <div class="section-header">
        <span class="section-tag">
          <i class="ti ti-chart-bar"></i>
          Performance Metrics
        </span>
        <h2 class="section-title">Typical Results</h2>
      </div>

      <div class="results-grid">
        
        <div class="result-card">
          <div class="result-icon">
            <i class="ti ti-cash"></i>
          </div>
          <h3>$15K - $75K</h3>
          <p class="result-label">Average Case Value</p>
        </div>

        <div class="result-card">
          <div class="result-icon">
            <i class="ti ti-users"></i>
          </div>
          <h3>30% - 45%</h3>
          <p class="result-label">Lead-to-Consultation Rate</p>
        </div>

        <div class="result-card">
          <div class="result-icon">
            <i class="ti ti-check"></i>
          </div>
          <h3>60% - 80%</h3>
          <p class="result-label">Consultation-to-Acceptance Rate</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="final-cta-section">
    <div class="final-cta-content">
      <div class="final-cta-icon">
        <i class="ti ti-diamond"></i>
      </div>
      
      <h2>Ready to Attract More High-Value Cases?</h2>
      
      <p class="final-cta-text">
        Stop settling for low-value cleanings and fillings. Let us help you attract the premium 
        patients who value quality dentistry and are willing to invest in their smile.
      </p>
      
      <a href="/book-a-call" class="final-cta-button">
        <i class="ti ti-calendar-event"></i>
        Speak to Our Team
      </a>
    </div>
  </section>

  <FooterBar />
  <!-- <StickyCTA /> -->

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    });
  </script>

</body>
</html>