---
// social-media-content-planning.astro - Social Media Content & Planning
import '../css/main.css';
import Navigation from '../components/Navigation.astro';
import FooterBar from '../components/FooterBar.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media Content & Planning | Dentistry Growth Partners</title>
  <meta name="description" content="AI-generated, research-backed content that keeps your practice top-of-mind with strategic social media management.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="icon" type="image/png" href="/636f4050ef41c9124a12cbba/dgp-logo1.png" />
  <link rel="shortcut icon" type="image/png" href="/636f4050ef41c9124a12cbba/dgp-logo1.png" />
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary-light: #EDEDE8;
      --primary-dark: #051023;
      --primary-blue: #07387D;
      --accent-blue: #248EEF;
      --white: #ffffff;
      --black: #1d1d1d;
      --grey: #f5f5f5;
      --dim-grey: #646464;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--white);
      color: var(--black);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .section-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* HERO SECTION */
    .hero-section {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 160px 24px 100px;
    }

    .hero-background-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url('https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=1920&q=80');
      background-size: cover;
      background-position: center;
      z-index: 0;
    }

    .hero-background-overlay::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(5, 16, 35, 0.75) 0%, rgba(7, 56, 125, 0.70) 50%, rgba(36, 142, 239, 0.68) 100%);
      z-index: 1;
    }

    .hero-background-overlay::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: radial-gradient(circle, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 30px 30px;
      z-index: 2;
    }

    .hero-container {
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .hero-content {
      text-align: center;
      position: relative;
    }

    .hero-section h1 {
      font-size: clamp(42px, 5.5vw, 62px);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.15;
      margin: 0 0 24px 0;
      letter-spacing: -1.8px;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      position: relative;
    }

    .hero-subtitle {
      font-size: clamp(20px, 2.2vw, 24px);
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.6;
      margin-bottom: 0;
      font-weight: 600;
    }

    /* DESCRIPTION SECTION */
    .description-section {
      padding: 120px 24px;
      background: var(--white);
    }

    .description-content {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
    }

    .description-content p {
      font-size: 19px;
      color: var(--dim-grey);
      line-height: 1.8;
      margin-bottom: 24px;
    }

    .description-content p:last-child {
      margin-bottom: 0;
    }

    /* KEY FEATURES SECTION */
    .features-section {
      padding: 120px 24px;
      background: var(--primary-light);
      position: relative;
      overflow: hidden;
    }

    .features-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url('https://images.unsplash.com/photo-1606811971618-4486d14f3f99?w=1920&q=80');
      background-size: cover;
      background-position: center;
      opacity: 0.03;
      z-index: 0;
    }

    .features-section .section-container {
      position: relative;
      z-index: 1;
    }

    .section-header {
      max-width: 900px;
      margin: 0 auto 60px;
      text-align: center;
    }

    .section-title {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 20px;
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .feature-card {
      background: var(--white);
      border: 3px solid var(--grey);
      border-radius: 24px;
      padding: 48px 40px;
      transition: all 0.4s ease;
      position: relative;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, transparent 0%, rgba(36, 142, 239, 0.05) 100%);
      opacity: 0;
      transition: opacity 0.4s ease;
      border-radius: 24px;
    }

    .feature-card:hover {
      border-color: var(--accent-blue);
      transform: translateY(-8px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    }

    .feature-card:hover::before {
      opacity: 1;
    }

    .feature-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }

    .feature-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      color: var(--white);
      transition: all 0.4s ease;
      flex-shrink: 0;
    }

    .feature-card:hover .feature-icon {
      transform: scale(1.1) rotate(5deg);
    }

    .feature-card h3 {
      font-size: 24px;
      font-weight: 800;
      color: var(--primary-blue);
      letter-spacing: -0.5px;
      position: relative;
      z-index: 1;
    }

    .feature-card p {
      font-size: 16px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    /* BENEFITS SECTION */
    .benefits-section {
      padding: 120px 24px;
      background: var(--white);
    }

    .benefits-intro {
      max-width: 900px;
      margin: 0 auto 60px;
      text-align: center;
    }

    .benefits-intro p {
      font-size: 19px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin-top: 20px;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      max-width: 1300px;
      margin: 0 auto;
    }

    .benefit-card {
      background: var(--white);
      border: 3px solid var(--grey);
      border-radius: 24px;
      padding: 48px 36px;
      text-align: center;
      transition: all 0.4s ease;
      position: relative;
    }

    .benefit-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
      border-color: var(--accent-blue);
    }

    .benefit-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      font-size: 36px;
      color: var(--white);
    }

    .benefit-card h3 {
      font-size: 22px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 16px;
      letter-spacing: -0.3px;
    }

    .benefit-card p {
      font-size: 15px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
    }

    /* WHAT WE DELIVER SECTION */
    .deliver-section {
      padding: 120px 24px;
      background: var(--primary-light);
    }

    .deliver-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      max-width: 1300px;
      margin: 60px auto 0;
    }

    .deliver-card {
      background: var(--white);
      border: 3px solid transparent;
      border-radius: 20px;
      padding: 40px 32px;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .deliver-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, transparent 0%, rgba(36, 142, 239, 0.05) 100%);
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .deliver-card:hover {
      border-color: var(--accent-blue);
      transform: translateY(-8px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    }

    .deliver-card:hover::before {
      opacity: 1;
    }

    .deliver-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      color: var(--white);
      margin-bottom: 24px;
      transition: all 0.4s ease;
    }

    .deliver-card:hover .deliver-icon {
      transform: scale(1.1) rotate(5deg);
    }

    .deliver-card h3 {
      font-size: 22px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 12px;
      letter-spacing: -0.3px;
      position: relative;
      z-index: 1;
    }

    .deliver-card p {
      font-size: 15px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    /* FINAL CTA SECTION */
    .final-cta-section {
      padding: 100px 24px;
      background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-blue) 100%);
      position: relative;
      overflow: hidden;
    }

    .final-cta-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>') repeat;
      opacity: 0.3;
    }

    .final-cta-content {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 10;
    }

    .final-cta-icon {
      width: 100px;
      height: 100px;
      background: rgba(255, 255, 255, 0.15);
      border: 3px solid var(--white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 32px;
      font-size: 48px;
      color: var(--white);
    }

    .final-cta-section h2 {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      color: var(--white);
      margin-bottom: 24px;
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .final-cta-text {
      font-size: 20px;
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.7;
      margin-bottom: 40px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .final-cta-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 20px 48px;
      background: var(--white);
      color: var(--primary-blue);
      font-size: 18px;
      font-weight: 700;
      border-radius: 14px;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 3px solid var(--white);
      box-shadow: 0 8px 24px rgba(255, 255, 255, 0.3);
    }

    .final-cta-button:hover {
      background: transparent;
      color: var(--white);
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(255, 255, 255, 0.4);
    }

    .final-cta-button i {
      font-size: 22px;
    }

    /* FLOATING CTA */
    .floating-cta {
      position: fixed;
      bottom: 32px;
      right: 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      z-index: 1000;
    }

    .floating-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 24px;
      background: var(--primary-blue);
      color: var(--white);
      border-radius: 50px;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }

    .floating-btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
      background: var(--accent-blue);
    }

    /* RESPONSIVE */
    @media (max-width: 991px) {
      .hero-section {
        padding: 140px 24px 80px;
        min-height: 75vh;
      }

      .features-grid, .deliver-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .benefits-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .description-section, .features-section, .benefits-section, .deliver-section, .final-cta-section {
        padding: 80px 24px;
      }
    }

    @media (max-width: 767px) {
      .hero-section {
        padding: 130px 20px 60px;
        min-height: 70vh;
      }

      .hero-section h1 {
        font-size: clamp(32px, 7vw, 44px);
        margin-bottom: 20px;
      }

      .hero-subtitle {
        font-size: 18px;
      }

      .features-grid, .benefits-grid, .deliver-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .feature-card, .benefit-card, .deliver-card {
        padding: 36px 28px;
      }

      .feature-icon, .deliver-icon {
        width: 60px;
        height: 60px;
        font-size: 28px;
      }

      .benefit-icon {
        width: 70px;
        height: 70px;
        font-size: 32px;
      }

      .final-cta-icon {
        width: 80px;
        height: 80px;
        font-size: 40px;
      }

      .final-cta-text {
        font-size: 17px;
      }

      .final-cta-button {
        padding: 18px 36px;
        font-size: 16px;
        width: 100%;
        justify-content: center;
      }

      .description-section, .features-section, .benefits-section, .deliver-section, .final-cta-section {
        padding: 60px 20px;
      }

      .floating-cta {
        bottom: 20px;
        right: 20px;
        gap: 12px;
      }

      .floating-btn {
        padding: 14px 20px;
        font-size: 14px;
      }

      .floating-btn span {
        display: none;
      }
    }

    @media (max-width: 479px) {
      .hero-section {
        padding: 120px 16px 50px;
      }

      .hero-section h1 {
        font-size: clamp(28px, 8vw, 38px);
      }

      .feature-card h3, .benefit-card h3, .deliver-card h3 {
        font-size: 20px;
      }

      .final-cta-section h2 {
        font-size: 28px;
      }
    }
/* DESCRIPTION SECTION */
    .description-section {
      padding: 120px 24px;
      background: var(--white);
    }

    .description-content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .description-intro {
      text-align: center;
      margin-bottom: 80px;
    }

    .description-title {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 16px;
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .description-subtitle {
      font-size: 20px;
      color: var(--dim-grey);
      line-height: 1.6;
      margin: 0;
    }

    /* DESCRIPTION STEPS */
    .description-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      margin-bottom: 80px;
    }

    .description-step {
      text-align: center;
      position: relative;
      padding: 40px 24px;
      border-radius: 20px;
      background: var(--grey);
      transition: all 0.4s ease;
    }

    .description-step:hover {
      background: var(--primary-light);
      transform: translateY(-8px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    }

    .step-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      color: var(--white);
      font-size: 24px;
      font-weight: 800;
      border-radius: 50%;
      margin-bottom: 20px;
    }

    .step-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      color: var(--white);
      margin: 0 auto 20px;
      transition: all 0.4s ease;
    }

    .description-step:hover .step-icon {
      transform: scale(1.1) rotate(5deg);
    }

    .description-step h3 {
      font-size: 20px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 12px;
      letter-spacing: -0.3px;
    }

    .description-step p {
      font-size: 15px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
    }

    /* HIGHLIGHT BOX */
    .description-highlight {
      background: linear-gradient(135deg, rgba(7, 56, 125, 0.08) 0%, rgba(36, 142, 239, 0.08) 100%);
      border: 3px solid var(--primary-blue);
      border-radius: 24px;
      padding: 48px;
      display: flex;
      gap: 32px;
      align-items: flex-start;
    }

    .highlight-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
      color: var(--white);
      flex-shrink: 0;
    }

    .highlight-content h4 {
      font-size: 22px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 12px;
      letter-spacing: -0.3px;
    }

    .highlight-content p {
      font-size: 16px;
      color: var(--dim-grey);
      line-height: 1.7;
      margin: 0;
    }

    /* RESPONSIVE */
    @media (max-width: 991px) {
      .description-steps {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .description-highlight {
        flex-direction: column;
        text-align: center;
        padding: 40px;
      }

      .highlight-icon {
        margin: 0 auto;
      }
    }

    @media (max-width: 767px) {
      .description-section {
        padding: 80px 20px;
      }

      .description-steps {
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 60px;
      }

      .description-step {
        padding: 32px 24px;
      }

      .description-title {
        font-size: 32px;
        margin-bottom: 12px;
      }

      .description-subtitle {
        font-size: 17px;
      }

      .description-highlight {
        padding: 32px;
        gap: 20px;
      }

      .highlight-icon {
        width: 70px;
        height: 70px;
        font-size: 36px;
      }

      .highlight-content h4 {
        font-size: 19px;
      }
    }
  </style>
</head>
<body>
  <Navigation />
  
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="hero-background-overlay"></div>

    <div class="hero-container">
      <div class="hero-content">
        <h1>Social Media Content & Planning</h1>

        <p class="hero-subtitle">
          Research-backed content that keeps your practice top-of-mind.
        </p>
      </div>
    </div>
  </section>

  <!-- DESCRIPTION SECTION -->
  <section class="description-section">
    <div class="section-container">
      <div class="description-content">
        <p>
          We help your practice build a consistent, professional social presence without the time drain. Simply send us photos and videos of your team or practice — our experts turn them into high-performing content that attracts and engages patients.
        </p>
        <p>
          You’ll receive a 90-day content calendar with proven, high-converting topics, so you’ll always know what to record and when. Once submitted, we handle all editing, posting, and optimization for you.
        </p>
        <p>
          Not comfortable recording? No problem — send us what you have. Using your existing footage and AI content creation systems, we produce static images, carousels, and short-form reels that highlight your expertise, educate patients, and keep your practice top of mind in your community.
        </p>
      </div>
    </div>
  </section>

<!-- DESCRIPTION SECTION -->
<!-- 
